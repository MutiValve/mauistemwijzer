<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:mauistemwijzer.ViewModels"
    xmlns:converters="clr-namespace:mauistemwijzer.Converters"
    x:Class="mauistemwijzer.Views.ResultPage"
    x:DataType="vm:ResultViewModel"
    BackgroundColor="#0A0A0A"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <converters:StringToColorConverter x:Key="StringToColor" />
    </ContentPage.Resources>

    <!-- Uitschakel hardware-terugknop op de uitslag-pagina -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Padding="24,48,24,16">
            <Label
                Text="Jouw uitslag"
                TextColor="#F5A623"
                FontSize="30"
                FontAttributes="Bold" />
        </VerticalStackLayout>

        <!-- Beste match -->
        <Border
            Grid.Row="1"
            BackgroundColor="#141400"
            StrokeShape="RoundRectangle 16"
            Stroke="#F5A623"
            StrokeThickness="1"
            Margin="24,0"
            Padding="20,16">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="Beste match" TextColor="#F5A623" FontSize="13" FontAttributes="Bold" />
                    <Label Text="{Binding TopPartyName}" TextColor="White" FontSize="24" FontAttributes="Bold" />
                    <Label Text="{Binding TopPartyScore, StringFormat='{0} overeenkomst'}"
                           TextColor="#AAAAAA" FontSize="14" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Partij scores lijst -->
        <ScrollView Grid.Row="2">
            <CollectionView
                ItemsSource="{Binding PartyResults}"
                Margin="24,20">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PartyResultItem">
                        <VerticalStackLayout Margin="0,0,0,20" Spacing="8">

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <!-- Partijkleur / Logo -->
                                <Border
                                    Grid.Column="0"
                                    WidthRequest="38"
                                    HeightRequest="38"
                                    BackgroundColor="{Binding Party.Color, Converter={StaticResource StringToColor}}"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent">
                                    <Grid>
                                        <Image
                                            Source="{Binding Party.Logo}"
                                            Aspect="AspectFit"
                                            IsVisible="{Binding Party.HasLogo}"
                                            Margin="2" />
                                        <Label
                                            Text="{Binding Party.Abbreviation}"
                                            TextColor="White"
                                            FontSize="9"
                                            FontAttributes="Bold"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            HorizontalTextAlignment="Center"
                                            IsVisible="{Binding Party.HasNoLogo}" />
                                    </Grid>
                                </Border>

                                <!-- Partijnaam -->
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Party.DisplayName}"
                                    TextColor="White"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center" />

                                <!-- Score percentage -->
                                <Label
                                    Grid.Column="2"
                                    Text="{Binding ScoreText}"
                                    TextColor="#F5A623"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center" />
                            </Grid>

                            <!-- Score balk -->
                            <ProgressBar
                                Progress="{Binding ProgressValue}"
                                ProgressColor="{Binding Party.Color, Converter={StaticResource StringToColor}}"
                                BackgroundColor="#1E1E1E"
                                HeightRequest="8" />

                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <!-- Knoppen onderaan -->
        <VerticalStackLayout Grid.Row="3" Spacing="12" Margin="24,12,24,32">

            <!-- Primair: naar de politieke roos -->
            <Button
                Text="Bekijk Politieke Roos"
                Command="{Binding ShowPoliticalGraphCommand}"
                BackgroundColor="#F5A623"
                TextColor="#0A0A0A"
                FontAttributes="Bold"
                FontSize="16"
                CornerRadius="30"
                HeightRequest="52" />

            <!-- Secundair: opnieuw beginnen -->
            <Button
                Text="Opnieuw beginnen"
                Command="{Binding RestartCommand}"
                BackgroundColor="Transparent"
                TextColor="#888888"
                FontSize="14"
                BorderColor="#333333"
                BorderWidth="1"
                CornerRadius="30"
                HeightRequest="44" />

        </VerticalStackLayout>

    </Grid>
</ContentPage>

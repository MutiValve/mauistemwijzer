<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:mauistemwijzer.ViewModels"
    x:Class="mauistemwijzer.Views.QuestionPage"
    x:DataType="vm:QuestionViewModel"
    BackgroundColor="#0A0A0A"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="6,Auto,*,Auto">

        <!-- Voortgangsbalk bovenin -->
        <ProgressBar
            Grid.Row="0"
            Progress="{Binding ProgressValue}"
            ProgressColor="#F5A623"
            BackgroundColor="#1E1E1E"
            VerticalOptions="Fill"
            HeightRequest="6"
            Margin="0" />

        <!-- Vraag info header -->
        <VerticalStackLayout
            Grid.Row="1"
            Padding="24,28,24,0"
            Spacing="6">
            <Label
                Text="{Binding CurrentQuestion.Category}"
                TextColor="#F5A623"
                FontSize="26"
                FontAttributes="Bold" />
            <Label
                Text="{Binding QuestionNumberText}"
                TextColor="#666666"
                FontSize="13" />
            <Label
                Text="Test je politieke voorkeuren aan de hand van 20 stellingen"
                TextColor="#555555"
                FontSize="12" />
            <BoxView HeightRequest="1" BackgroundColor="#1E1E1E" Margin="0,10,0,0" />
        </VerticalStackLayout>

        <!-- Stelling + knoppen -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="24,20,24,0" Spacing="14">

                <!-- Stelling tekst -->
                <Label
                    Text="{Binding CurrentQuestion.Statement}"
                    TextColor="White"
                    FontSize="16"
                    LineBreakMode="WordWrap"
                    Margin="0,0,0,10" />

                <!-- Eens -->
                <Button
                    Text="👍  Eens"
                    Command="{Binding AnswerEensCommand}"
                    BackgroundColor="#1B5E20"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="28"
                    HeightRequest="52"
                    HorizontalOptions="Fill" />

                <!-- Geen van beide -->
                <Border
                    BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 28"
                    Stroke="#444444"
                    StrokeThickness="1"
                    HeightRequest="52">
                    <Button
                        Text="Geen van beide"
                        Command="{Binding AnswerGeenVanBeideCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#CCCCCC"
                        FontSize="16"
                        HeightRequest="52"
                        HorizontalOptions="Fill" />
                </Border>

                <!-- Oneens -->
                <Button
                    Text="Oneens  👎"
                    Command="{Binding AnswerOneensCommand}"
                    BackgroundColor="#7F1D1D"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="16"
                    CornerRadius="28"
                    HeightRequest="52"
                    HorizontalOptions="Fill" />

                <!-- Overslaan -->
                <Border
                    BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 22"
                    Stroke="#333333"
                    StrokeThickness="1"
                    HeightRequest="44">
                    <Button
                        Text="Overslaan"
                        Command="{Binding OvergeslaanCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#666666"
                        FontSize="14"
                        HeightRequest="44"
                        HorizontalOptions="Fill" />
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Ga terug knop -->
        <Button
            Grid.Row="3"
            Text="Ga terug"
            Command="{Binding GoBackCommand}"
            BackgroundColor="#F5A623"
            TextColor="#0A0A0A"
            FontAttributes="Bold"
            FontSize="16"
            CornerRadius="30"
            HeightRequest="52"
            Margin="24,12,24,32" />

    </Grid>
</ContentPage>

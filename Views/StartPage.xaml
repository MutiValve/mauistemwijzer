<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:mauistemwijzer.ViewModels"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"

    x:Class="mauistemwijzer.Views.StartPage"
    x:DataType="vm:StartViewModel"
    BackgroundColor="#0A0A0A"
    Shell.NavBarIsVisible="False">
    
    

    <Grid>
        <VerticalStackLayout
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="20"
            Padding="40,0">

            <!-- Logo -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                <Label
                    Text="Stem"
                    FontSize="40"
                    FontAttributes="Bold"
                    TextColor="White"
                    VerticalOptions="Center" />
                <Border
                    BackgroundColor="#F5A623"
                    StrokeShape="RoundRectangle 10"
                    Stroke="Transparent"
                    Padding="12,4"
                    VerticalOptions="Center">
                    <Label
                        Text="Hub"
                        FontSize="40"
                        FontAttributes="Bold"
                        TextColor="#0A0A0A" />
                </Border>
            </HorizontalStackLayout>

            <!-- Subtitel verkiezingen -->
            <Label
                Text="Tweedekamer Verkiezingen 2026"
                TextColor="#F5A623"
                FontSize="20"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Margin="0,8,0,0" />

            <!-- Omschrijving -->
            <Label
                Text="Test je politieke voorkeuren aan de hand van 20 stellingen"
                TextColor="#AAAAAA"
                FontSize="14"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,24" />

            <!-- Start knop -->
            <Button
                Text="Start"
                Command="{Binding StartCommand}"
                BackgroundColor="#F5A623"
                TextColor="#0A0A0A"
                FontAttributes="Bold"
                FontSize="18"
                CornerRadius="30"
                HeightRequest="56"
                WidthRequest="220"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </Grid>

</ContentPage>
